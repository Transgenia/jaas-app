# Non-secret configuration for tgn-meetings. Copy to
# /opt/transgenia-meetings/meetings.env (root:tgn-meetings 0640).
# Secrets never go here: they are files under ./secrets (scripts/set-secret.sh).

PUBLIC_ORIGIN=https://meet.transgenia.org

# JaaS console → API Keys. The App ID and key ID are visible to participants
# (meeting URL and JWT header), so they are configuration, not secrets.
JAAS_APP_ID=vpaas-magic-cookie-REPLACE
JAAS_API_KEY_ID=vpaas-magic-cookie-REPLACE/REPLACE

# Pick a model the account has: docker compose run --rm meetings models
OPENAI_MODEL=REPLACE
WORKER_MAX_ATTEMPTS=5
MAX_TRANSCRIPT_MB=20
MAX_TRANSCRIPT_CHARS=500000

# Hosts JaaS uses for pre-authenticated links ("*" = exactly one DNS label).
DOWNLOAD_ALLOWED_HOSTS=objectstorage.*.oraclecloud.com
WEBHOOK_TOLERANCE_SECONDS=300

# Peers allowed to set X-Real-IP (the host nginx reaches the container via
# the docker bridge gateway).
TRUSTED_PROXIES=127.0.0.0/8,::1,172.16.0.0/12

# Retention (days; 0 = keep): transcripts and minutes. Deleting a room
# deletes its recordings, transcripts and minutes immediately.
TRANSCRIPT_RETENTION_DAYS=90
MINUTES_RETENTION_DAYS=365
DISPLAY_TIMEZONE=America/Mexico_City

# Cloudflare Access in front of /admin (Zero Trust → Access → Applications).
# Both values are public identifiers. REQUIRE_CF_ACCESS=true refuses to start
# without them.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# With Access configured each person signs in with their own e-mail and only
# sees the rooms they created; ADMIN_EMAILS see everything. The app re-checks
# the e-mail against these lists (exact addresses or whole domains).
CF_ACCESS_ALLOWED_EMAILS=
CF_ACCESS_ALLOWED_DOMAINS=transgenia.org
ADMIN_EMAILS=admin@transgenia.org
REQUIRE_CF_ACCESS=false
